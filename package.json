{
  "name": "legal-mcp-harness",
  "version": "1.0.0",
  "description": "MCP harness for legal research, contract review, and legal document drafting services.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "eval": "tsx src/evaluate.ts",
    "test:web": "npm --prefix web run build",
    "test": "npm run build && npm run eval && vitest run && npm run test:web"
  },
  "keywords": [
    "mcp",
    "legal",
    "harness"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
